# Safe local-development defaults only. Test and production deployments must
# provide unique values through their own secret-management system.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=local-mongodb-password-change-me
PYTHON_ENV=development
JWT_SECRET_KEY=local-only-jwt-signing-key-change-me-32chars
JWT_EXPIRATION_HOURS=24
PLATFORM_ADMIN_EMAIL=local-admin@example.com
PLATFORM_ADMIN_PASSWORD=local-admin-password-change-me
OLLAMA_MODEL=phi3:latest
OLLAMA_MODEL_DIGEST=4f222292793889a9a40a020799cfd28d53f3e01af25d48e06c5e708610fc47e9
LLM_ANALYSIS_ENABLED=false
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=2048
LLM_CONTEXT_MAX_BYTES=65536
LLM_SCHEDULER_INTERVAL_SECONDS=5
LLM_JOB_LEASE_SECONDS=1200
LLM_RETRY_BACKOFF_SECONDS=5,10,20
PLAYBOOK_CONTEXT_WEBHOOKS_ENABLED=false
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
WEBHOOK_SECRET_ENCRYPTION_KEY=
PLAYBOOK_WEBHOOK_MAX_REQUEST_BYTES=262144
PLAYBOOK_WEBHOOK_MAX_RESPONSE_BYTES=16384
PLAYBOOK_WEBHOOK_MAX_TOTAL_PROMPT_BYTES=65536
PLAYBOOK_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
PLAYBOOK_WEBHOOK_MAX_COUNT=10
PLAYBOOK_WEBHOOK_MAX_CONCURRENCY=5
ENRICHMENT_ACTIONS_ENABLED=false
KNOWLEDGE_BASE_PROCESSING_ENABLED=false
KNOWLEDGE_BASE_RETRIEVAL_ENABLED=false
KNOWLEDGE_BASE_PROCESSOR_INTERVAL_SECONDS=5
KNOWLEDGE_BASE_PROCESSOR_LEASE_SECONDS=600
KNOWLEDGE_BASE_MAX_CANDIDATES=500
KNOWLEDGE_BASE_PROMPT_MAX_BYTES=32768
ENRICHMENT_ACTION_MAX_COUNT=10
ENRICHMENT_ACTION_MAX_CONCURRENCY=5
ENRICHMENT_ACTION_SCHEDULER_INTERVAL_SECONDS=2
ENRICHMENT_ACTION_MAX_REQUEST_BYTES=262144
ENRICHMENT_ACTION_MAX_RESPONSE_BYTES=32768
ENRICHMENT_ACTION_MAX_CONTEXT_BYTES=16384
NEXT_PUBLIC_API_URL=http://localhost:8000
# Canonical TierX frontend override; the unbranded name above remains compatible.
# NEXT_PUBLIC_TIERX_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_RECEIVED_TOPIC=received
KAFKA_VALIDATED_TOPIC=validated
KAFKA_NORMALIZED_TOPIC=normalized
KAFKA_ENRICHED_TOPIC=enriched
KAFKA_CLUSTERED_TOPIC=clustered
KAFKA_DISTINCT_TOPIC=distinct
KAFKA_DEAD_LETTER_TOPIC=dead_letter_queue
KAFKA_TRACE_TOPIC=alert_processing_events
DEBUG_TRACE_ENABLED=true
CORRELATION_ENABLED=false
DEBUG_TRACE_RETENTION_DAYS=7
DEBUG_TRACE_MAX_SNAPSHOT_BYTES=262144
APP_RELEASE_SHA=development
APP_RELEASE_VERSION=development
INGESTION_PROXY_URL=http://ingestion-proxy:8000
JIRA_ATTACHMENT_RETENTION_DAYS=7
JIRA_QUARANTINE_CLEANUP_SECONDS=3600
JIRA_INGESTION_RETRY_SECONDS=30
# Optional self-hosted semantic KB layer; enable after pinned-model preflight.
TIERX_KB_SEMANTIC_INDEXING_ENABLED=false
TIERX_KB_SEMANTIC_RETRIEVAL_ENABLED=false
TIERX_KB_SEMANTIC_MIN_SCORE=0.70
