FROM docker:28.5.2-cli@sha256:625d9431a9f54c5a2bc90f24f0e1c3d55b1349fd857dd85035f98c2c9acbdd4d AS cli
FROM python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df
LABEL org.opencontainers.image.licenses="AGPL-3.0-only"
COPY --from=cli /usr/local/bin/docker /usr/local/bin/docker
COPY kb_shared /packages/kb_shared
RUN pip install --no-cache-dir /packages/kb_shared
COPY python_runner/broker.py /runner/broker.py
WORKDIR /runner
USER 2101:2101
CMD ["python", "-I", "/runner/broker.py"]
