FROM python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df
LABEL org.opencontainers.image.licenses="AGPL-3.0-only"
# No package manager/bootstrap wheels in the user-code runtime.
RUN python -m pip uninstall --yes pip && rm -rf /usr/local/lib/python3.12/ensurepip
WORKDIR /runner
COPY python_runner/execute.py python_runner/proxy.py /runner/
COPY python_runner/tierx_tools.py /usr/local/lib/python3.12/site-packages/tierx_tools.py
USER 65532:65532
CMD ["python", "-I", "/runner/execute.py"]
