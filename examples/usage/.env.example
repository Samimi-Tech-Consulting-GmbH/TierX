# Use the exact published release that contains these examples and installation support.
# The previous v0.2.0 release does not contain the new installer.
TIERX_RELEASE=
TIERX_BIND_ADDRESS=127.0.0.1
TIERX_HTTP_PORT=8080
TIERX_MONGO_ROOT_USER=tierx
TIERX_MONGO_URL=
TIERX_MONGO_ROOT_PASSWORD=
TIERX_JWT_SECRET_KEY=
TIERX_WEBHOOK_SECRET_ENCRYPTION_KEY=
TIERX_INSTALLATION_ENABLED=true
TIERX_INSTALLATION_TOKEN=
TIERX_BOOTSTRAP_CONFIGURED=false
# Optional locked settings / environment-only installation:
TIERX_PLATFORM_ADMIN_EMAIL=
TIERX_PLATFORM_ADMIN_PASSWORD=
TIERX_PUBLIC_URL=
TIERX_OLLAMA_URL=
TIERX_OLLAMA_MODEL=
TIERX_LLM_ANALYSIS_ENABLED=
TIERX_CORRELATION_ENABLED=
TIERX_KNOWLEDGE_BASE_PROCESSING_ENABLED=
TIERX_KNOWLEDGE_BASE_RETRIEVAL_ENABLED=
TIERX_APP_RELEASE_SHA=
TIERX_DEBUG_TRACE_ENABLED=false
TIERX_ENRICHMENT_ACTIONS_ENABLED=false
TIERX_KB_SEMANTIC_INDEXING_ENABLED=false
TIERX_KB_SEMANTIC_RETRIEVAL_ENABLED=false
TIERX_EMBEDDING_OLLAMA_URL=
