# Set environment variables in your shell (or use Node's --env-file support).
# No provider is enabled or chosen implicitly.
SANDBOX_AI_PROVIDER=disabled
# ollama: origin, e.g. http://127.0.0.1:11434
# openai-compatible: API base, e.g. https://ai.example/v1
SANDBOX_AI_URL=
SANDBOX_AI_MODEL=
SANDBOX_AI_API_KEY=
# Optional private archive directory; default .sandbox-data beside server.mjs.
SANDBOX_DATA_DIR=
